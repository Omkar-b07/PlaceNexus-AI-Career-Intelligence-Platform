PORT=5000
# MongoDB Atlas or local MongoDB connection string. Never commit a real username or password.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=placenexus
# Placement data uses MONGODB_URI above. DSA preparation content uses this separate database.
PREPARATION_MONGODB_URI=
PREPARATION_MONGODB_DB_NAME=PlaceNexusPreparation
# Optional fallback for environments where Node cannot resolve mongodb+srv DNS records.
MONGODB_SEED_HOSTS=
MONGODB_REPLICA_SET=
# Gemini is optional. The analysis remains available with deterministic recommendations when it is unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set this to a long, unique random value in deployed environments.
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800
# Off-campus job provider. These values are read only by the backend.
JOB_API_PROVIDER=adzuna
JOB_API_BASE_URL=https://api.adzuna.com/v1/api
JOB_API_COUNTRY=in
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
OFF_CAMPUS_CACHE_MINUTES=30
# The OAuth Web Client ID from Google Cloud. It is safe to share with the frontend.
GOOGLE_CLIENT_ID=
